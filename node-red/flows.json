    {
        "id": "func_esik",
        "type": "function",
        "z": "flow_su_deposu",
        "name": "Esik kontrol + debounce",
        "func": "// ============================================================\n//  Seviye bildirimi (band durum makinesi + debounce)\n//  Bir banda ILK girince TEK bildirim; ayni bandda tekrar etmez.\n//  Band degisince yeni bildirim (orn. dolarken 90->100, bosalirken 20->5).\n//    >=100 : doldu        |  >=90  : dolmak uzere\n//    <20   : dusuk seviye |  <=5   : su tukendi\n//    20..89: normal (bildirim yok)\n// ============================================================\n\n// >>> AYARLANABILIR <<<\nconst DOLU = 100;                  // \"doldu\" esigi (%)\nconst DOLMAK_UZERE = 90;           // \"dolmak uzere\" esigi (%)\nconst DUSUK = 20;                  // \"dusuk seviye\" esigi (%)\nconst TUKENDI = 5;                 // \"su tukendi\" esigi (%)\nconst CHAT_ID = \"\";     // Telegram chat_id (README'ye bak)\n\nconst veri = msg.payload;\nif (!veri || typeof veri.yuzde !== \"number\") {\n    return null;  // gecersiz mesaj, yok say\n}\nconst yuzde = veri.yuzde;\n\n// Bandi belirle (yukaridan asagiya oncelik)\nlet band;\nif (yuzde >= DOLU)              band = \"dolu\";\nelse if (yuzde >= DOLMAK_UZERE) band = \"dolmak_uzere\";\nelse if (yuzde <= TUKENDI)      band = \"tukendi\";\nelse if (yuzde < DUSUK)         band = \"dusuk\";\nelse                           band = \"normal\";\n\nconst onceki = context.get(\"band\") || \"\";\nif (band === onceki) {\n    return null;  // ayni band -> debounce, tekrar bildirme\n}\ncontext.set(\"band\", band);\n\n// Banda gore mesaj + durum rengi\nlet mesaj = null, renk = \"green\";\nif (band === \"dolu\")              { mesaj = \"✅ Su deposu DOLDU! (seviye %\" + yuzde + \")\";            renk = \"blue\";   }\nelse if (band === \"dolmak_uzere\") { mesaj = \"⚠️ Su deposu dolmak uzere (seviye %\" + yuzde + \")\";      renk = \"yellow\"; }\nelse if (band === \"dusuk\")        { mesaj = \"🔻 Su deposu seviyesi DUSUK (%\" + yuzde + \") — esik %\" + DUSUK + \" alti\"; renk = \"orange\"; }\nelse if (band === \"tukendi\")      { mesaj = \"🆘 SU TUKENDI! (seviye %\" + yuzde + \")\";                 renk = \"red\";    }\n\nnode.status({ fill: renk, shape: \"dot\", text: band + \" (%\" + yuzde + \")\" });\n\nif (mesaj === null) {\n    return null;  // normal band, bildirim gerekmiyor\n}\n\nmsg.payload = { chatId: CHAT_ID, type: \"message\", content: mesaj };\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 300,
        "wires": [
            [
                "telegram_gonder"
            ]
        ]
