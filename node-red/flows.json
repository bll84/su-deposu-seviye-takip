        "id": "yuzde_cikar",
        "type": "function",
        "z": "flow_su_deposu",
        "name": "Yuzde sayisini cikar",
        "func": "// Gauge ve grafik sadece SAYI ister; nesneden yuzde'yi cikar.\nif (msg.payload && typeof msg.payload.yuzde === 'number') {\n    msg.payload = msg.payload.yuzde;\n    return msg;\n}\nreturn null;",
